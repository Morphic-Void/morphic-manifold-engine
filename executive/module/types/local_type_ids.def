//  Component-local type identity catalog.
//  Defines MV_LOCAL_TYPES(type_macro).

#define MV_LOCAL_TYPES(type_macro) \
    type_macro(executive, executive::CExecutiveModuleTag) \
    type_macro(tga_load_state, executive::SExecutiveTgaLoadState) \
    type_macro(tga_save_state, executive::SExecutiveTgaSaveState)
