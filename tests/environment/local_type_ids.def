    type_macro(tga_file_load, test_environment::STestTgaFileLoadState) \
    type_macro(tga_decode, test_environment::STestTgaDecodeState) \
    type_macro(tga_encode, test_environment::STestTgaEncodeState) \
    type_macro(tga_file_save, test_environment::STestTgaFileSaveState)
